#!/bin/sh
# Rejects any commit message that does not follow Conventional Commits.
subject=$(head -n 1 "$1")

case "$subject" in
  Merge\ * | Revert\ * | fixup!\ * | squash!\ *) exit 0 ;;
esac

pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9-]+\))?!?: [^ ].{0,71}$'

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  echo "commit-msg: \"$subject\" is not a Conventional Commit." >&2
  echo "Expected: type(scope): short description (72 characters max)." >&2
  exit 1
fi
